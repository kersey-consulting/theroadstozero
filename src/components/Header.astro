---
import { getSanityClient, queries } from '@/lib/sanity';
import HeaderClient from './HeaderClient';

// siteSettings is fetched once in BaseLayout and passed down — Header, Footer
// and the JSON-LD builder all need it, and it used to be fetched three times
// per request.
interface Props {
  settings?: any;
}

const { settings } = Astro.props as Props;

const sanityClient = getSanityClient(Astro.locals.runtime?.env);
const navigation = await sanityClient.fetch(queries.navigation).catch(() => null);

// Fallback if Sanity hasn't been populated yet
// No `phone` here: the client has removed the phone number from the site, and
// this fallback would otherwise bring it back whenever Sanity is unreachable.
const fallbackSettings = {
  businessName: 'The Road to Zero',
  email: 'info@theroadstozero.com',
  bookingUrl: 'https://app.profileaestheticmanagement.com/appointment-scheduler/22d112f1-8ed0-4d6c-b903-8e907383633e',
  socialLinks: [
    { platform: 'facebook', url: 'https://www.facebook.com/theroadtozero0/' },
    { platform: 'instagram', url: 'https://www.instagram.com/theroadtozero0/' },
    { platform: 'youtube', url: 'https://www.youtube.com/@Theroadtozero0' },
    { platform: 'tiktok', url: 'https://www.tiktok.com/@Theroadtozero0' },
  ],
};

const fallbackNavigation = {
  items: [
    { _key: 'home', label: 'Home', href: '/' },
    { _key: 'about', label: 'About Us', href: '/about' },
    { _key: 'whyus', label: 'Why Us', href: '/why-us' },
    { _key: 'location', label: 'Locations', href: '/locations' },
    {
      _key: 'services', label: 'Services', href: '/services',
      children: [
        { _key: 'aesthetic-treatments', label: 'Aesthetic Treatments', href: '/services/aesthetic-treatments' },
        { _key: 'body-transformation', label: 'Body Transformation', href: '/services/body-transformation' },
        { _key: 'iv-therapy', label: 'IV Therapy & Vitamin Injections', href: '/services/iv-therapy' },
        { _key: 'medical-weight-management', label: 'Medical Weight Management', href: '/services/medical-weight-management' },
        { _key: 'peptide-hormone-support', label: 'Peptide & Hormone Support', href: '/services/peptide-hormone-support' },
        { _key: 'holistic-services', label: 'Holistic Services', href: '/services/holistic-services' },
      ],
    },
  ],
};
---

<div class="headerStickyShell">
  <HeaderClient
    client:load
    settings={settings || fallbackSettings}
    navigation={navigation || fallbackNavigation}
  />
</div>

<style>
  .headerStickyShell {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--color-background);
  }
</style>
