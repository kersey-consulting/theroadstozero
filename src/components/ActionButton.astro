---
import Button from './Button.astro';
import BookButton from './BookButton.astro';
import { isBookingHref } from '@/lib/booking';

// A section button from Sanity. Booking links become a BookButton; everything
// else renders as authored.
interface Props {
  action: { label: string; href: string };
  /** The service the page is about, for the booking text message. */
  service?: string;
}

const { action, service } = Astro.props;
---

{isBookingHref(action.href)
  ? <BookButton service={service} />
  : <Button label={action.label} href={action.href} theme="primary" />}
