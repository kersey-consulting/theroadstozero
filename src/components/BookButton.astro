---
import Button from './Button.astro';
import { getSiteSettings } from '@/lib/siteSettings';
import { smsHref, telHref } from '@/lib/booking';

interface Props {
  /** Named in the pre-filled text message, e.g. "Hi! I'd like to book NAD+ IV." */
  service?: string;
}

const { service } = Astro.props;
const settings = await getSiteSettings(Astro.locals);
const phone: string | undefined = settings?.phone?.trim() || undefined;
const sms = smsHref(phone, service);
const tel = telHref(phone);
---

{/* Texting only makes sense on a phone: touch-first devices get the sms: link,
    everything else sees the number (still a tel: link, for FaceTime etc.). */}
{sms && tel ? (
  <>
    <Button device="touch" label="Text to Book" href={sms} theme="primary" />
    <Button device="desktop" label={phone!} href={tel} ariaLabel={`Call ${phone} to book`} theme="primary" />
  </>
) : (
  // No phone number in Site Settings: send people somewhere that still works.
  <Button label="Contact Us to Book" href="/contact" theme="primary" />
)}
