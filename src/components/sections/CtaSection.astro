---
import Button from '@/components/Button.astro';
import PortableInline from './PortableInline.astro';
import { portableNodes } from '@/lib/portableText';
import type { PortableTextBlock } from '@/lib/portableText';

interface Props {
  section: {
    id?: string;
    title?: string;
    content?: PortableTextBlock[];
    /** Pre-rich-text field. See the fallback below. */
    text?: string;
    actions?: { label: string; href: string }[];
  };
}

const { section } = Astro.props;

// `text` became `content` when this section moved to rich text. Reading both
// means the deploy and the Sanity migration can happen in either order without
// a window where every CTA on the site renders empty — and an un-migrated
// draft still shows its copy.
const legacyBlocks = (text: string): PortableTextBlock[] =>
  text
    .split(/\n\s*\n/)
    .map((chunk) => chunk.trim())
    .filter(Boolean)
    .map((chunk) => ({ _type: 'block', style: 'normal', markDefs: [], children: [{ text: chunk }] }));

const blocks = Array.isArray(section?.content) && section.content.length > 0
  ? section.content
  : legacyBlocks(section?.text ?? '');

const nodes = portableNodes(blocks);
---
<section id={section?.id} class="section">
  <div class="ctaCard">
    {section?.title && <h2 class="sectionTitleCentered">{section.title}</h2>}
    {nodes.length > 0 && (
      <div class="ctaBody">
        {nodes.map((node) => {
          if (node.type === 'bulletList') return <ul class="ctaList">{node.items.map((item) => <li><PortableInline children={item} /></li>)}</ul>;
          if (node.type === 'blockquote') return <blockquote class="ctaQuote"><PortableInline children={node.children} /></blockquote>;
          return <p class="centeredText"><PortableInline children={node.children} /></p>;
        })}
      </div>
    )}
    <div class="ctaActions">{(section?.actions ?? []).map((action) => <Button label={action.label} href={action.href} theme="primary" />)}</div>
  </div>
</section>
<style>
  .section { padding: 5rem 1.5rem; }
  .ctaCard { width: min(100%, 960px); margin: 0 auto; text-align: center; background: white; border-radius: 24px; padding: 2rem; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08); }
  .sectionTitleCentered { margin: 0 0 1.5rem; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; text-align: center; }
  .ctaBody { max-width: 760px; margin: 0 auto; }
  .centeredText { text-align: center; margin: 0 auto; font-size: 1.05rem; line-height: 1.85; }
  .centeredText + .centeredText { margin-top: 1rem; }
  /* Bullets sit in a left-aligned block that is itself centred, so the markers
     line up instead of ragging around the middle of the card. */
  .ctaList { display: inline-block; text-align: left; margin: 1rem 0 0; padding-left: 1.35rem; font-size: 1.05rem; line-height: 1.85; }
  .ctaList li + li { margin-top: 0.35rem; }
  .ctaQuote { margin: 1.25rem auto 0; padding-left: 1rem; border-left: 3px solid var(--color-secondary); text-align: left; max-width: 60ch; font-size: 1.05rem; line-height: 1.85; }
  .ctaActions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .ctaBody :global(a) { color: var(--color-primary); text-decoration: underline; }
</style>
