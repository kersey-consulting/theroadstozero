---
interface Service {
  _id?: string;
  name?: string;
  slug?: { current?: string };
  category?: { slug?: { current?: string } };
  type?: string;
  tagline?: string;
  shortDescription?: string;
  keyBenefits?: string[];
  image?: string;
}

interface Props {
  section: { id?: string;
    title?: string;
    intro?: string;
    services?: Service[];
  };
  variant?: 'default' | 'alt';
}

import { sanityImage } from '@/lib/image';

const { section, variant = 'default' } = Astro.props;
// .cardImage is display:none in every breakpoint, so this never paints. Keeping
// it lazy stops the browser fetching an image it will never show; the tag itself
// is left in place in case the design brings it back.
const services = (section?.services ?? []).map((service) => ({
  ...service,
  cardImage: sanityImage(service.image, 400),
}));
const serviceHref = (service: Service) => {
  const categorySlug = service?.category?.slug?.current;
  const serviceSlug = service?.slug?.current;
  if (!serviceSlug) return '#';
  if (categorySlug && categorySlug !== 'iv-therapy') return `/services/${categorySlug}/${serviceSlug}`;
  if (categorySlug === 'iv-therapy') return `/services/iv-therapy/${serviceSlug}`;
  return `/services/${serviceSlug}`;
};
---

<section id={section?.id} class:list={['section', variant === 'alt' && 'sectionAlt']}>
  <div class="wide">
    {section?.title && <h2 class="sectionTitleCentered">{section.title}</h2>}
    {section?.intro && <p class="centeredText">{section.intro}</p>}
    <div class="servicesGrid">
      {services.map((service) => (
        <article class="card">
          {service.image && <img class="cardImage" src={service.cardImage.src} srcset={service.cardImage.srcset} width={service.cardImage.width} height={service.cardImage.height} loading="lazy" decoding="async" alt={service.name ?? 'Service image'} />}
          <div class="cardContent">
            {(service.tagline ?? service.type) && <span class="cardTag">{service.tagline ?? service.type}</span>}
            <h3 class="cardTitle">{service.name}</h3>
            {service.shortDescription && <p class="cardSubtext">{service.shortDescription}</p>}
            {(service.keyBenefits?.length ?? 0) > 0 && (
              <ul class="benefitsList">
                {service.keyBenefits?.map((benefit) => <li>{benefit}</li>)}
              </ul>
            )}
            <a class="cardButton" href={serviceHref(service)}>Learn More</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section, .sectionAlt { padding: 5rem 1.5rem; }
  .sectionAlt { background: rgba(210, 185, 150, 0.12); }
  .wide { width: min(1200px, 100%); margin: 0 auto; }
  .sectionTitleCentered { margin: 0 0 1.5rem; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; text-align: center; }
  .centeredText { text-align: center; max-width: 760px; margin: 0 auto 2rem; font-size: 1.05rem; line-height: 1.85; }
  .servicesGrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .card {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.07);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-top: 4px solid var(--color-secondary);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12); }
  .cardImage { display: none; }
  .cardContent { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 0.85rem; padding: 0; }
  .cardTag { display: inline-flex; padding: 0.3rem 0.8rem; border-radius: 999px; background: rgba(210, 185, 150, 0.18); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.09em; }
  .cardTitle { margin: 0; color: var(--color-primary); font-size: 1.3rem; line-height: 1.2; }
  .cardSubtext { margin: 0; color: var(--color-primary); font-size: 0.95rem; line-height: 1.75; }
  .benefitsList { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.88rem; line-height: 1.7; color: var(--color-primary); opacity: 0.85; }
  .cardButton { display: block; width: 100%; text-align: center; padding: 1rem; margin-top: auto; color: var(--color-primary); background: transparent; border: 2px solid; border-radius: 15px; }
  .cardButton:hover, .cardButton:focus { background: var(--color-surface); box-shadow: 0 0 10px rgba(0, 0, 0, 0.5); text-decoration: none; }
  @media (max-width: 768px) {
    .section, .sectionAlt { padding: 4rem 1.25rem; }
  }
</style>
