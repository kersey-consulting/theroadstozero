---
import HeroSection from './HeroSection.astro';
import RichTextSection from './RichTextSection.astro';
import CardsSection from './CardsSection.astro';
import FeaturedServiceCategoriesSection from './FeaturedServiceCategoriesSection.astro';
import ServiceListSection from './ServiceListSection.astro';
import StaffSection from './StaffSection.astro';
import TagListSection from './TagListSection.astro';
import SplitContentSection from './SplitContentSection.astro';
import ImageShowcaseSection from './ImageShowcaseSection.astro';
import ReviewsSection from './ReviewsSection.astro';
import FaqSection from './FaqSection.astro';
import CtaSection from './CtaSection.astro';
import LegalSection from './LegalSection.astro';

interface Props {
  sections?: any[];
  staffMembers?: any[];
}

const { sections = [], staffMembers = [] } = Astro.props;

// The LCP image is the first one that actually paints, which is not always in
// section 0 — service pages often open with a text section. Find the first
// section that renders an image so it can load eagerly instead of lazily.
const sectionHasImage = (section: any) => {
  switch (section?._type) {
    case 'heroSection':
    case 'splitContentSection':
      return Boolean(section.imageUrl ?? section.image);
    case 'imageShowcaseSection':
      return (section.items ?? []).some((item: any) => item?.imageUrl ?? item?.image);
    case 'featuredServiceCategoriesSection':
      return (section.categories ?? []).some((c: any) => c?.homeCardImage ?? c?.image);
    case 'staffSection':
      // Staff photos are resolved from refs against the staffMembers prop.
      return (section.staffMembers ?? []).some(
        (ref: any) => staffMembers.find((s: any) => s._id === ref?._ref)?.photo,
      );
    default:
      return false;
  }
};

const firstImageIndex = sections.findIndex(sectionHasImage);
// Only worth prioritising if it is near the top; further down it is below the
// fold and lazy loading is the better trade.
const priorityIndex = firstImageIndex >= 0 && firstImageIndex <= 2 ? firstImageIndex : -1;
---

{sections.map((section, index) => {
  const variant = index % 2 === 1 ? 'alt' : 'default';
  const priority = index === priorityIndex;

  if (section._type === 'heroSection') {
    return <HeroSection section={section} priority={priority} />;
  }
  if (section._type === 'richTextSection') {
    return <RichTextSection section={section} variant={variant} />;
  }
  if (section._type === 'cardsSection') {
    return <CardsSection section={section} variant={variant} />;
  }
  if (section._type === 'featuredServiceCategoriesSection') {
    return <FeaturedServiceCategoriesSection section={section} variant={variant} priority={priority} />;
  }
  if (section._type === 'serviceListSection') {
    return <ServiceListSection section={section} variant={variant} />;
  }
  if (section._type === 'staffSection') {
    return <StaffSection section={section} staffMembers={staffMembers} variant={variant} priority={priority} />;
  }
  if (section._type === 'tagListSection') {
    return <TagListSection section={section} variant={variant} />;
  }
  if (section._type === 'splitContentSection') {
    return <SplitContentSection section={section} variant={variant} priority={priority} />;
  }
  if (section._type === 'imageShowcaseSection') {
    return <ImageShowcaseSection section={section} variant={variant} priority={priority} />;
  }
  if (section._type === 'reviewsSection') {
    return <ReviewsSection section={section} variant={variant} />;
  }
  if (section._type === 'faqSection') {
    return <FaqSection section={section} variant={variant} />;
  }
  if (section._type === 'ctaSection') {
    return <CtaSection section={section} />;
  }
  if (section._type === 'legalSection') {
    return <LegalSection section={section} variant={variant} />;
  }

  return null;
})}
