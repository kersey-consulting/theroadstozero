---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { buildJsonLd } from '@/lib/schema';
import type { BreadcrumbItem, ServiceSchemaInput } from '@/lib/schema';
import { resolveBusinessProfile } from '@/lib/businessInfo';
import { resolveOgImage } from '@/lib/ogImage';
import { getSanityClient, queries } from '@/lib/sanity';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * The page's `seo.image` — a Sanity image object, or a URL string. Optional:
   * with nothing passed the page's own lead image is used, then the site-wide
   * default. See `resolveOgImage`.
   */
  ogImage?: unknown;
  sections?: any[];
  /** Emits a `Service` node tied to the site-wide business. Service pages only. */
  service?: ServiceSchemaInput | null;
  /** Emits `BreadcrumbList`. Needs at least two entries to be worth anything. */
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = '',
  ogImage = null,
  sections = [],
  service = null,
  breadcrumbs = [],
} = Astro.props;

// Fetched once here rather than separately in Header and Footer; all three
// consumers (plus the JSON-LD below) need the same document.
const sanityClient = getSanityClient(Astro.locals.runtime?.env);
const settings = await sanityClient.fetch(queries.siteSettings).catch(() => null);
const business = resolveBusinessProfile(settings);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteOrigin = new URL(Astro.site ?? 'https://theroadstozero.com').origin;

const ogImageResolved = resolveOgImage({
  seoImage: ogImage,
  sections,
  settingsImage: settings?.ogImage,
});
// Scrapers do not resolve relative paths, so a /public asset needs the origin.
const ogImageUrl = ogImageResolved.url.startsWith('http')
  ? ogImageResolved.url
  : `${siteOrigin}${ogImageResolved.url}`;
const jsonLd = buildJsonLd({
  title,
  description,
  url: canonicalUrl.toString(),
  sections,
  business,
  service,
  breadcrumbs,
  siteOrigin,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Every image is served from the Sanity CDN, so open that connection early. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageResolved.width)} />
    <meta property="og:image:height" content={String(ogImageResolved.height)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/icons/icon.ico" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon.png" />
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HWWBSHGEWT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HWWBSHGEWT');
    </script>
  </head>
  <body>
    <Header settings={settings} />
    <main id="main" class="siteMain">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>

<style>
  .siteMain {
    padding-top: var(--site-header-offset, 146px);
  }

  @media (max-width: 1110px) {
    .siteMain {
      padding-top: var(--site-header-offset-mobile, 111px);
    }
  }
</style>
