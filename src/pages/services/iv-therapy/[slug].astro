---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageSections from '@/components/sections/PageSections.astro';
import { getSanityClient, queries } from '@/lib/sanity';
import { fetchDocument, contentUnavailable } from '@/lib/routing';

export async function getStaticPaths() {
  const sanityClient = getSanityClient(Astro.locals.runtime?.env);
  const allServices = await sanityClient.fetch(
    `*[_type == "service" && category->slug.current == "iv-therapy"]{
      "slug": slug.current
    } | order(order asc)`
  ).catch(() => []);

  return allServices
    .filter((service: any) => service.slug)
    .map((service: any) => ({
      params: { slug: service.slug },
    }));
}

const sanityClient = getSanityClient(Astro.locals.runtime?.env);
const { slug } = Astro.params;
const { doc: service, lookupFailed } = await fetchDocument<any>(sanityClient, queries.serviceBySlug, { slug });

if (!service) {
  // A failed lookup is not evidence the page is gone, so only a genuine miss 404s.
  return lookupFailed ? contentUnavailable() : Astro.rewrite('/404');
}

const staffMembers = await sanityClient.fetch(queries.staffMembers).catch(() => []);
---

<BaseLayout title={service.seo?.title ?? service.name} description={service.seo?.description ?? service.shortDescription ?? service.heroText ?? ''} sections={service.sections ?? []}>
  <PageSections sections={service.sections ?? []} staffMembers={staffMembers} />
</BaseLayout>
