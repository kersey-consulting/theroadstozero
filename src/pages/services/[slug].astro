---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageSections from '@/components/sections/PageSections.astro';
import { getSanityClient, queries } from '@/lib/sanity';
import { fetchDocument, contentUnavailable } from '@/lib/routing';

export async function getStaticPaths() {
  const sanityClient = getSanityClient(Astro.locals.runtime?.env);
  const categories = await sanityClient.fetch(`*[_type == "serviceCategory"]{ "slug": slug.current }`).catch(() => []);

  return categories
    .filter((category: any) => category.slug && category.slug !== 'iv-therapy')
    .map((category: any) => ({
      params: { slug: category.slug },
    }));
}

const sanityClient = getSanityClient(Astro.locals.runtime?.env);
const { slug } = Astro.params;
const { doc: category, lookupFailed } = await fetchDocument<any>(sanityClient, queries.serviceCategoryBySlug, { slug });

if (!category) {
  // A failed lookup is not evidence the page is gone, so only a genuine miss 404s.
  return lookupFailed ? contentUnavailable() : Astro.rewrite('/404');
}
---

<BaseLayout title={category.seo?.title ?? `${category.title} — The Road to Zero`} description={category.seo?.description ?? category.description ?? ''} sections={category.sections ?? []}>
  <PageSections sections={category.sections ?? []} />
</BaseLayout>
