<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>The Road to Zero Admin</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg: #f7f3ef;
      --card: #ffffff;
      --border: #e6ddd4;
      --text: #22201f;
      --muted: #766d66;
      --accent: #8a6f56;
      --accent-dark: #6f5843;
    }

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 2rem 1rem;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top left, rgba(138, 111, 86, 0.18), transparent 32rem),
        var(--bg);
      color: var(--text);
    }

    .card {
      width: min(100%, 440px);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: 0 24px 60px rgba(62, 48, 38, 0.12);
      padding: 2rem;
    }

    h1 { margin: 0 0 0.5rem; font-size: 2rem; }
    p { color: var(--muted); margin: 0; line-height: 1.55; }

    label {
      display: block;
      margin-top: 1rem;
      font-weight: 650;
    }

    input {
      width: 100%;
      margin-top: 0.35rem;
      padding: 0.75rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 1rem;
    }

    button,
    .tool-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 44px;
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 0.7rem 1rem;
      background: var(--accent);
      color: white;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
    }

    button:hover,
    .tool-link:hover { background: var(--accent-dark); }

    form button { margin-top: 1.35rem; }

    .tool-list {
      display: grid;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .secondary { background: #a9a19a; margin-top: 1.5rem; }
    .secondary:hover { background: #8f867d; }
    #error { min-height: 1.4rem; margin-top: 0.85rem; color: #9f3412; }
  </style>
</head>
<body>
  <main class="card" id="login">
    <h1>Admin</h1>
    <p>Sign in to access The Road to Zero reporting tools.</p>

    <form id="loginForm">
      <label>
        Username
        <input id="username" type="text" autocomplete="username" required />
      </label>
      <label>
        Password
        <input id="password" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit">Sign in</button>
    </form>

    <div id="error" role="status" aria-live="polite"></div>
  </main>

  <main class="card" id="tools" style="display:none;">
    <h1>Admin Tools</h1>
    <p>Select a private tool to continue.</p>

    <div class="tool-list">
      <a class="tool-link" href="/admin/analytics">Analytics Dashboard</a>
    </div>

    <button class="secondary" type="button" onclick="logout()">Log out</button>
  </main>

  <script>
    const AUTH_KEY = 'trtz_admin_auth';
    const loginCard = document.getElementById('login');
    const toolsCard = document.getElementById('tools');
    const errorDiv = document.getElementById('error');

    if (sessionStorage.getItem(AUTH_KEY)) showTools();

    document.getElementById('loginForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      errorDiv.textContent = '';

      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value;
      const encoded = btoa(`${username}:${password}`);

      try {
        const res = await fetch('/admin/api/analytics', {
          headers: {'Authorization': 'Basic ' + encoded},
        });

        if (res.status === 401) {
          errorDiv.textContent = 'Invalid username or password.';
          return;
        }

        if (!res.ok) {
          errorDiv.textContent = 'Unable to verify credentials.';
          return;
        }

        sessionStorage.setItem(AUTH_KEY, encoded);
        showTools();
      } catch {
        errorDiv.textContent = 'Network error. Please try again.';
      }
    });

    function showTools() {
      loginCard.style.display = 'none';
      toolsCard.style.display = 'block';
    }

    function logout() {
      sessionStorage.removeItem(AUTH_KEY);
      window.location.reload();
    }
  </script>
</body>
</html>
